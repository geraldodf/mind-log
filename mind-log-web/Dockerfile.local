# Build local para revisão visual — NÃO é a imagem de produção.
#
# Diferença para o `Dockerfile`: usa a configuração `development` do Angular,
# que mantém `src/environments/environment.ts` (apiPath http://localhost:8080/api)
# em vez de trocá-lo pelo `environment.prod.ts`, que aponta para a API real
# em mindlog-api.daroz.dev.

FROM node:22.13.1-slim AS build

WORKDIR /app

COPY package.json package-lock.json ./

RUN npm install --quiet

COPY . .

RUN npx ng build --configuration=development

FROM nginx:stable-alpine3.20

COPY nginx/nginx.conf /etc/nginx/nginx.conf

COPY --from=build /app/dist/mind-log-web/browser /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
